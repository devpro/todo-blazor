    <PackageVersion Include="Withywoods.AspNetCore.Mvc.Testing" Version="2.0.5" />
    <PackageVersion Include="Withywoods.Configuration" Version="2.0.5" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
